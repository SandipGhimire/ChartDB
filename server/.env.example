NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://chartdb:chartdb@localhost:5432/chartdb?schema=public
SESSION_COOKIE_NAME=chartdb_sid
SESSION_TTL_HOURS=168

# Session cookie's Secure flag. Defaults to NODE_ENV (true in production).
# Set to false only if this server is reached over plain HTTP (no TLS-
# terminating reverse proxy in front) -- otherwise the browser will refuse
# to store the cookie and login will silently fail.
COOKIE_SECURE=

# Bootstrap admin, only used on first boot when the users table is empty
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
