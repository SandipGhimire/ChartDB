# Postgres connection for the server container. Point this at your
# already-running Postgres container/host (see docker-compose.yml's
# postgres_net note if it's a container on another Docker network).
DATABASE_URL=postgresql://chartdb:chartdb@postgres:5432/chartdb?schema=public

# Session cookie
SESSION_COOKIE_NAME=chartdb_sid
SESSION_TTL_HOURS=168
# Set to false only when serving over plain HTTP with no TLS-terminating
# reverse proxy in front -- otherwise browsers won't store the cookie and
# login will silently fail. Leave blank to default to Secure (recommended).
COOKIE_SECURE=

# Bootstrap admin account, created once on first boot when the users table
# is empty. Leave blank to skip and create the first admin via psql/seed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Host port the app (nginx) is published on
HTTP_PORT=80

# Optional: AI-assisted features (leave blank to disable)
VITE_OPENAI_API_KEY=
VITE_OPENAI_API_ENDPOINT=
VITE_LLM_MODEL_NAME=

# Optional: frontend feature flags
VITE_HIDE_CHARTDB_CLOUD=true
VITE_DISABLE_ANALYTICS=true
