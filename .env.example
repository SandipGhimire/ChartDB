# Read by `npm run build` (Vite) when building the frontend. Not used at
# runtime -- these values get baked into the built JS bundle.

# Optional: AI-assisted features (leave blank to disable)
VITE_OPENAI_API_KEY=
VITE_OPENAI_API_ENDPOINT=
VITE_LLM_MODEL_NAME=

# Optional: frontend feature flags
VITE_HIDE_CHARTDB_CLOUD=true
VITE_DISABLE_ANALYTICS=true

# Multi-user backend mode -- keep as "api"
VITE_STORAGE_MODE=api
