[Unit]
Description=ChartDB backend API + WebSocket server
After=network.target

[Service]
Type=simple
User=chartdb
WorkingDirectory=/opt/chartdb/server
EnvironmentFile=/opt/chartdb/server/.env
ExecStartPre=/usr/bin/npx prisma migrate deploy
ExecStart=/usr/bin/node dist/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
